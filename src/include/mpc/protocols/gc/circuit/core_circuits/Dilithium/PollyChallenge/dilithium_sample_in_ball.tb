`timescale 1ns / 1ps

//////////////////////////////////////////////////////////////////
//                Testbench: dilithium_polly_challenge          //
//////////////////////////////////////////////////////////////////
// Description:                                                 //
//   Tests Dilithium2, Dilithium3, and Dilithium5 configurations//
//   using randomized input data.                               //
//                                                              //
// Author:     Kiarash Sedghi (kiarashs@usf.edu)                //
// Date:       June 2025                                        //
//////////////////////////////////////////////////////////////////

module dilithium_polly_challenge_tb;

    reg  [8*136-1:0] data_in;
    wire [2*256-1:0] coeffs_out_2;
    wire [2*256-1:0] coeffs_out_3;
    wire [2*256-1:0] coeffs_out_5;

    localparam integer N    = 256;
    localparam integer TAU2 = 39;
    localparam integer TAU3 = 49;
    localparam integer TAU5 = 60;

    integer i;

    // DUT instantiations
    dilithium2_polly_challenge #(.TAU(TAU2), .N(N)) dut2 (
        .data_in(data_in),
        .coeffs_out(coeffs_out_2)
    );

    dilithium3_polly_challenge #(.TAU(TAU3), .N(N)) dut3 (
        .data_in(data_in),
        .coeffs_out(coeffs_out_3)
    );

    dilithium5_polly_challenge #(.TAU(TAU5), .N(N)) dut5 (
        .data_in(data_in),
        .coeffs_out(coeffs_out_5)
    );

    // Test process
    initial begin
        $display("====================================================");
        $display("       Starting Testbench: Dilithium Variants       ");
        $display("====================================================");

        // Randomize input
        for (i = 0; i < 136; i = i + 1)
            data_in[i*8 +: 8] = $urandom;



        #10; // Allow propagation

        // ---------- Dilithium2 ----------
        $display("\n----------------- Dilithium2 Coefficients -----------------");
        for (i = 0; i < N; i = i + 1) begin
            case (coeffs_out_2[i*2 +: 2])
                2'b01: $display("D2 coeff[%0d] = 0", i);
                2'b10: $display("D2 coeff[%0d] = +1", i);
                2'b00: $display("D2 coeff[%0d] = -1", i);
                default: $display("D2 coeff[%0d] = INVALID", i);
            endcase
        end

        // ---------- Dilithium3 ----------
        $display("\n----------------- Dilithium3 Coefficients -----------------");
        for (i = 0; i < N; i = i + 1) begin
            case (coeffs_out_3[i*2 +: 2])
                2'b01: $display("D3 coeff[%0d] = 0", i);
                2'b10: $display("D3 coeff[%0d] = +1", i);
                2'b00: $display("D3 coeff[%0d] = -1", i);
                default: $display("D3 coeff[%0d] = INVALID", i);
            endcase
        end

        // ---------- Dilithium5 ----------
        $display("\n----------------- Dilithium5 Coefficients -----------------");
        for (i = 0; i < N; i = i + 1) begin
            case (coeffs_out_5[i*2 +: 2])
                2'b01: $display("D5 coeff[%0d] = 0", i);
                2'b10: $display("D5 coeff[%0d] = +1", i);
                2'b00: $display("D5 coeff[%0d] = -1", i);
                default: $display("D5 coeff[%0d] = INVALID", i);
            endcase
        end

        $display("\nTestbench complete.");
        $finish;
    end

endmodule
